<Window x:Class="IDE_Decorator.IDE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDE" Height="820" Width="1550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" KeyDown="Window_KeyDown" VerticalAlignment="Center"
        WindowStyle="None" WindowState="Maximized" Topmost="True">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#3F4185"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallRoundDanger" TargetType="Button">
            <Setter Property="Background" Value="#FFECEC"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="BorderBrush" Value="#E6B0AA"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileSystemTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFF3DD4E"/>
                    <Setter Property="Background" Value="#3F4185"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF635C5C">
            <Button x:Name="btnShowFiles" Content="📁" Width="30" Height="24" Background="#FFF6F676" Foreground="Black" Click="btnShowFiles_Click" Margin="10,0,0,0" FontWeight="Bold" ToolTip="Mostrar/Ocultar explorador"/>
            <Button x:Name="btnRun" Content="▶" Width="25" Height="25" Background="#FF7CFF8D" Margin="10,0,10,0" Click="btnRun_Click" ToolTip="Run (F5 o CTRL+R)"/>
            <Button x:Name="btnStop" Content="⯃" Width="25" Height="25" Background="#FFE36565" Margin="0,0,10,0" Click="btnStop_Click"/>
            <Button x:Name="btnTerminal" Content=">_" Width="25" Height="25" Background="#FF201D1D" Margin="0,0,10,0" Click="btnTerminal_Click" Foreground="White" ToolTip="Terminal Python (CTRL+T)"/>
            <Button x:Name="btnHighlightSyntax" Content="✎_" Width="25" Height="25" Background="#FF292626" Margin="0,0,10,0" Click="btnHighlightSyntax_Click" Foreground="#FFDDC378" BorderBrush="#FFDCAF70" FontSize="14" ToolTip="Formatear script"/>
            <Button x:Name="btnSignScript" Content="✒️" Width="30" Height="25" Background="#FF1A2A3A" Margin="0,0,10,0" Click="btnSignScript_Click" Foreground="#FF37A1B9" BorderBrush="#FF37A1B9" ToolTip="Firmar script con SHA-256"/>
            <Label x:Name="lblProjectName" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="1080"/>

            <Grid Width="296" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="181,0,0,0" Width="296">
                    <Button x:Name="btnUploadAssignment" Content="↑" Width="30" Height="25" Background="#5B5EC7" Foreground="White" Margin="0,0,10,0"/>
                    <Button x:Name="btnReturn" Content="x" Width="30" Height="25" Background="#FFFF1A45" Foreground="White" Margin="0,0,10,0" Click="btnReturn_Cick"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Background="#FF352D2D">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colPadding" Width="20"/>
                <ColumnDefinition x:Name="colFiles" Width="340" MinWidth="340"/>
                <ColumnDefinition x:Name="colSplitter" Width="3"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="spFiles" Grid.Row="0" Grid.Column="0" Background="#2E2E2E" Padding="8" Grid.ColumnSpan="2">
                <Grid>
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="btnTabProject" Click="btnTabProject_Click"/>
                        <Button x:Name="btnTabSystem" Click="btnTabSystem_Click"/>
                        <Button x:Name="btnTabTasks" Click="btnTabTasks_Click"/>
                        <Grid x:Name="tabProject"/>
                        <Grid x:Name="tabTasks"/>
                        <Grid x:Name="tabSystem">
                            <Button x:Name="btnSysUp" Click="btnSysUp_Click"/>
                            <TextBox x:Name="txtSysPath" KeyDown="txtSysPath_KeyDown"/>
                            <Button x:Name="btnSysGo" Click="btnSysGo_Click"/>
                            <ComboBox x:Name="cmbSysFilter" SelectionChanged="cmbSysFilter_SelectionChanged"/>
                            <Button x:Name="btnSysRefresh" Click="btnSysRefresh_Click"/>
                            <Button x:Name="btnOpenInProject" Click="btnOpenInProject_Click"/>
                            <TreeView x:Name="tvSystem" SelectedItemChanged="tvSystem_SelectedItemChanged" MouseDoubleClick="tvSystem_MouseDoubleClick"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Archivos" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="btnNewFile" Content="+ Archivo" Width="80" Height="24" Click="btnNewFile_Click" Margin="0,0,5,0" Style="{StaticResource RoundedButton}" FontSize="11"/>
                            <Button x:Name="btnNewFolder" Content="+ Carpeta" Width="80" Height="24" Click="btnNewFolder_Click" Margin="0,0,5,0" Style="{StaticResource RoundedButton}" FontSize="11"/>
                            <Button x:Name="btnDelete" Content="🗑" Width="32" Height="24" Click="btnDelete_Click" Style="{StaticResource SmallRoundDanger}" FontSize="13"/>
                        </StackPanel>

                        <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <TreeView x:Name="tvFiles" Background="Transparent" Foreground="#FFF3DD4E" BorderThickness="0" 
                                      ItemContainerStyle="{StaticResource FileSystemTreeItem}"
                                      SelectedItemChanged="tvFiles_SelectedItemChanged"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="tvFiles_PreviewMouseLeftButtonDown"
                                      MouseMove="tvFiles_MouseMove"
                                      Drop="tvFiles_Drop"
                                      DragOver="tvFiles_DragOver"
                                      PreviewKeyDown="tvFiles_PreviewKeyDown"
                                      MouseDoubleClick="tvFiles_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="tvFiles_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="tvFiles_ContextMenuOpening"/>
                        </ScrollViewer>


                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="filesSplitter" Grid.Row="0" Grid.Column="2" Width="5" HorizontalAlignment="Center" Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtLineNumbers" Background="#FF3C3C3C" Foreground="White" BorderThickness="0" IsReadOnly="True" TextAlignment="Center" FontFamily="Consolas" FontSize="14" Padding="0,10,0,0" VerticalScrollBarVisibility="Hidden"/>

            <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtEditor" Background="#FF8E8E8E" Foreground="White" BorderThickness="0" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" Padding="10,10,0,0" VerticalScrollBarVisibility="Auto" Text="Write your code here..." GotFocus="txtEditor_Click" DataObject.Pasting="txtEditor_Pasting" DataObject.Copying="txtEditor_Copying" TextChanged="txtEditor_TextChanged"/>

            <GridSplitter x:Name="txtConsoleSeparator" Grid.Row="1" Grid.ColumnSpan="5" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Black"/>

            <TextBox Grid.Row="2" Grid.ColumnSpan="5" x:Name="txtConsole" Background="Black" FontFamily="Consolas" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" Height="120" MinHeight="120" Focusable="False" />

            <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,-4" Visibility="Collapsed" x:Name="spConsoleInput">
                <TextBox x:Name="txtConsoleInput" Width="1450" Height="28" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" KeyDown="txtConsoleInput_KeyDown" AcceptsTab="True"/>
                <Button x:Name="btnConsoleSend" Content="Enviar" Width="80" Height="28" Margin="8,0,0,0" Click="btnConsoleSend_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>